<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="rgbd_camera" params="parent xyz pitch">
    <joint name="rgbd_camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="rgbd_camera_link"/>
      <origin xyz="${xyz}" rpy="0 ${pitch} 0"/>
    </joint>
    <link name="rgbd_camera_link">
      <visual>
        <origin xyz="-0.01 0 0" rpy="0 0 0"/>
        <geometry><box size="0.02 0.08 0.025"/></geometry>
        <material name="dark"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>
    <joint name="rgbd_camera_optical_joint" type="fixed">
      <parent link="rgbd_camera_link"/>
      <child link="rgbd_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    <link name="rgbd_camera_optical_frame"/>

    <gazebo reference="rgbd_camera_link">
      <sensor type="depth" name="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.085595</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>8.0</far></clip>
        </camera>
        <plugin name="rgbd_camera_controller" filename="libgazebo_ros_camera.so">
          <ros><namespace>/camera</namespace></ros>
          <camera_name>rgbd</camera_name>
          <frame_name>rgbd_camera_optical_frame</frame_name>
          <min_depth>0.05</min_depth>
          <max_depth>8.0</max_depth>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
